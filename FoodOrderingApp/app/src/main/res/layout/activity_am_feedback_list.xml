<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="24dp"
        tools:context=".ui.activityfragment.customer.accountmanagement.am_feedback_list">

        <include
            android:id="@+id/include2"
            layout="@layout/header_with_btnback" />

        <LinearLayout
            android:id="@+id/ll_fbList1"
            app:layout_constraintTop_toBottomOf="@id/include2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:paddingRight="16dp"
            tools:ignore="MissingConstraints">
            <TextView
                android:id="@+id/lbl_order_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Mã đơn hàng:"
                android:textColor="@color/lightgray"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/include2" />

            <TextView
                android:id="@+id/txt_orderID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFamily="@font/roboto_regular"
                android:text="#orderID"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@+id/lbl_order_id"
                app:layout_constraintTop_toBottomOf="@+id/include2" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_fbList2"
            app:layout_constraintTop_toBottomOf="@id/ll_fbList1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lbl_order_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Trạng thái:"
                android:textColor="@color/lightgray"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lbl_order_id" />



            <TextView
                android:id="@+id/txt_order_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/secondary"
                android:textSize="18sp"
                app:layout_constraintStart_toEndOf="@+id/lbl_order_status"
                app:layout_constraintTop_toBottomOf="@+id/txt_orderID" />
        </LinearLayout>




        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFeedbackList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_fbList2" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>


