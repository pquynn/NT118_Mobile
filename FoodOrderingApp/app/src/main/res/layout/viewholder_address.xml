<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="checkoutVM"
            type="com.example.foodorderingapp.ui.viewmodel.customer.checkout.CheckoutViewModel" />
        <variable
            name="userAddress"
            type="com.example.foodorderingapp.data.model.entity.UserAddress" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewholder_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_grey_container"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="10dp">


        <FrameLayout
            android:id="@+id/white_circle"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/circle_white"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img_location"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/location" />

        </FrameLayout>


    <!--    <ImageView-->
    <!--        android:id="@+id/img_location"-->
    <!--        android:layout_width="35dp"-->
    <!--        android:layout_height="35dp"-->
    <!--        android:layout_marginStart="32dp"-->
    <!--        android:layout_marginTop="16dp"-->
    <!--        android:layout_marginBottom="24dp"-->
    <!--        app:layout_constraintBottom_toBottomOf="parent"-->
    <!--        app:layout_constraintStart_toStartOf="parent"-->
    <!--        app:layout_constraintTop_toTopOf="parent"-->
    <!--        app:srcCompat="@drawable/location" />-->

        <!--    style textview: if the lenght of the string exceeds the textview width,
            use the last 3 rows to wrap text. Modified by Quyen, 3/4/2024-->
        <TextView
            android:id="@+id/txt_full_address"
            style="@style/text_14sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:singleLine="false"
            android:text="@{userAddress.allAddress}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/white_circle"
            app:layout_constraintTop_toBottomOf="@+id/txt_recipient_phone" />

        <ImageView
            android:id="@+id/btn_edit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/txt_full_address"
            app:layout_constraintEnd_toStartOf="@+id/btn_delete"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/edit" />

        <ImageView
            android:id="@+id/btn_delete"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/txt_full_address"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/trash" />

        <TextView
            android:id="@+id/txt_recipient_name"

            style="@style/bold_text_16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:text="@{userAddress.recipientName}"
            app:layout_constraintStart_toEndOf="@+id/white_circle"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_recipient_phone"
            style="@style/bold_text_16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@{userAddress.recipientPhone}"
            app:layout_constraintStart_toEndOf="@+id/white_circle"
            app:layout_constraintTop_toBottomOf="@+id/txt_recipient_name" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>