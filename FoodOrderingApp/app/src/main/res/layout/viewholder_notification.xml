<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
<!--        <variable name="notificationVM" type="com.example.foodorderingapp.ui.viewmodel.customer.notification.NotificationViewModel"/>-->
        <variable name="notification" type="com.example.foodorderingapp.data.model.entity.Notification"/>
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewholder_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!--    style textview: if the lenght of the string exceeds the textview width,
            use the last 3 rows to wrap text. Modified by Quyen, 3/4/2024-->
        <TextView
            android:id="@+id/txt_noti_message"
            style="@style/text_14sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:lines="2"
            android:singleLine="false"
            android:text="@{notification.content}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/green_rec"
            app:layout_constraintTop_toBottomOf="@+id/txt_noti_name" />

        <TextView
            android:id="@+id/txt_noti_name"
            style="@style/bold_text_18sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:singleLine="false"
            android:text="@{notification.title}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/green_rec"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_date"
            style="@style/text_14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/placeholder"
            app:dateFormatted="@{notification.date}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/green_rec"
            app:layout_constraintTop_toBottomOf="@+id/txt_noti_message" />

        <!--    todo: CREATE JAVAJOY IMAGE FOR NOTI -->
        <FrameLayout
            android:id="@+id/green_rec"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rectangle_primary"
            android:padding="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img_coupon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/javajoy_icon" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>