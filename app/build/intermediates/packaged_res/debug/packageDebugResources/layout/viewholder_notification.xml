<?xml version="1.0" encoding="utf-8"?>

                                                       
                                                               
    
                                                                                                                                            
                                                                                                         
           
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewholder_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" android:tag="layout/viewholder_notification_0" xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android">

        <!--    style textview: if the lenght of the string exceeds the textview width,
            use the last 3 rows to wrap text. Modified by Quyen, 3/4/2024-->
        <TextView
            android:id="@+id/txt_noti_message"
            style="@style/text_14sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="20dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:singleLine="false"
            android:tag="binding_1"               
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/green_rec"
            app:layout_constraintTop_toBottomOf="@+id/txt_noti_name" />

        <TextView
            android:id="@+id/txt_noti_name"
            style="@style/bold_text_18sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:singleLine="false"
            android:tag="binding_2"             
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/green_rec"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_date"
            style="@style/text_14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:tag="binding_3"                 
            android:textColor="@color/placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/green_rec"
            app:layout_constraintTop_toBottomOf="@+id/txt_noti_message" />

    <!--    todo: CREATE JAVAJOY IMAGE FOR NOTI -->
        <FrameLayout
            android:id="@+id/green_rec"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/rectangle_primary"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/img_coupon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/javajoy_icon" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
         