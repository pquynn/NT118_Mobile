<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodOrderingApp"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--   START: CART - CHECKOUT - PAYMENT-->
        <activity
            android:name=".activity.customer_module.cart.CartActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".activity.customer_module.checkout.BuySuccessActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".activity.customer_module.checkout.CheckoutActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".activity.customer_module.checkout.CheckoutAddressActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".activity.customer_module.checkout.CouponActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".activity.customer_module.checkout.PaymentMethodActivity"
            android:exported="true">
        </activity>
        <!--   END: CART - CHECKOUT - PAYMENT-->

        <!--    START: NOTIFICATION    -->
        <activity
            android:name=".activity.customer_module.notification.NotificationActivity"
            android:exported="true">
        </activity>

        <activity
            android:name=".activity.admin_module.notification.NotificationActivity"
            android:exported="true">
        </activity>
        <!--    END: NOTIFICATION    -->

        <!--   START: ACCOUNT-->
        <activity
            android:name=".activity.customer_module.AccountAddressActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".activity.customer_module.AddAddressActivity"
            android:exported="true">
        </activity>
        <!--   START: ACCOUNT-->
    </application>

</manifest>