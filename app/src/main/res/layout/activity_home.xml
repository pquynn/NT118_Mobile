<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- start header home -->
    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/circle_bg_color"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_menu"
            tools:ignore="MissingConstraints"
            tools:layout_editor_absoluteX="63dp"
            tools:layout_editor_absoluteY="35dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/textHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="45dp"
        android:text="DELIVERY TO"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/frameLayout"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/textHeader1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Halal Lab Office"
        android:textColor="@color/text_home_search"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/textHeader"
        app:layout_constraintTop_toBottomOf="@+id/textHeader"
        tools:ignore="MissingConstraints" />

    <!-- end header home -->

    <!-- start button search -->

    <ImageView
        android:id="@+id/img_polygon"
        android:layout_width="10dp"
        android:layout_height="7dp"
        android:layout_marginTop="67dp"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_polygon"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="177dp" />

    <FrameLayout
        android:id="@+id/frameLayoutSearch"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/rounder_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteY="162dp">

        <ImageView
            android:id="@+id/img_search"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:srcCompat="@drawable/ic_search"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/textSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tìm kiếm"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/text_home_search"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="55dp"
            android:layout_marginEnd="30dp"
            tools:ignore="HardcodedText" />
    </FrameLayout>
    <!-- end button search -->

    <TextView
        android:id="@+id/textCategory"
        android:layout_width="114dp"
        android:layout_height="26dp"
        android:text="Danh Mục"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/frameLayout"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteY="236dp" />

    <TextView
        android:id="@+id/textExtend1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:text="@string/extend"
        android:textColor="@color/primary"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/textCategory"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="10dp"
        android:layout_height="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/textExtend1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.2"
        app:layout_constraintStart_toEndOf="@+id/textExtend1"
        app:layout_constraintTop_toTopOf="@+id/textExtend1"
        app:srcCompat="@drawable/ic_extend"
        tools:ignore="MissingConstraints" />

    <FrameLayout
        android:id="@+id/frameLayoutCategory"
        android:layout_width="90dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/rounder_bg_category"
        android:backgroundTint="@color/lightgreen"
        app:layout_constraintBottom_toTopOf="@+id/textStore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textCategory"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/textAll"
            style="@style/Heading3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="All"
            tools:ignore="HardcodedText" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayoutCategory2"
        android:layout_width="90dp"
        android:layout_height="53dp"
        android:layout_marginStart="136dp"
        android:background="@drawable/rounder_bg_category"
        app:layout_constraintBottom_toTopOf="@+id/textStore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textCategory"
        app:layout_constraintVertical_bias="0.521"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/textTraSua"
            style="@style/Heading3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Trà sữa"
            tools:ignore="HardcodedText" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayoutCategory3"
        android:layout_width="90dp"
        android:layout_height="53dp"
        android:layout_marginStart="248dp"
        android:background="@drawable/rounder_bg_category"
        app:layout_constraintBottom_toTopOf="@+id/textStore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textCategory"
        app:layout_constraintVertical_bias="0.521"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/textTra"
            style="@style/Heading3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Trà"
            tools:ignore="HardcodedText" />
    </FrameLayout>

    <TextView
        android:id="@+id/textStore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cửa hàng"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/frameLayout"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteY="361dp" />

    <TextView
        android:id="@+id/textExtend2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:text="@string/extend"
        android:textColor="@color/primary"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/textStore"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="10dp"
        android:layout_height="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/textExtend2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.2"
        app:layout_constraintStart_toEndOf="@+id/textExtend2"
        app:layout_constraintTop_toTopOf="@+id/textExtend2"
        app:srcCompat="@drawable/ic_extend"
        tools:ignore="MissingConstraints" />



</androidx.constraintlayout.widget.ConstraintLayout>

