<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/img_cake"
        android:layout_width="0dp"
        android:layout_height="321dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/img6"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/txt_NameCake"
        style="@style/Heading2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Bánh mochi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_cake"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/txt_priceCake"
        style="@style/text_14sp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="20.000đ"
        app:layout_constraintEnd_toEndOf="@+id/txt_NameCake"
        app:layout_constraintStart_toStartOf="@+id/txt_NameCake"
        app:layout_constraintTop_toBottomOf="@+id/txt_NameCake"
        tools:ignore="HardcodedText" />

    
</androidx.constraintlayout.widget.ConstraintLayout>
