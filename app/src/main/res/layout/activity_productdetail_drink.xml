        <RadioGroup
            android:id="@+id/radioGroupSizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_depSize"
            tools:ignore="MissingConstraints">

            <!-- RadioButton sẽ được thêm vào đây bằng code -->

        </RadioGroup>
        <!--  END VIEW SIZE  -->

        <View
            android:id="@+id/View1"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="2dp"
            android:background="@color/search"
            app:layout_constraintEnd_toEndOf="@+id/linearLayout2"
            app:layout_constraintStart_toStartOf="@+id/linearLayout2"
            app:layout_constraintTop_toBottomOf="@+id/radioGroupSizes"
            tools:ignore="MissingConstraints" />

        <!-- START VIEW TOPPING  -->
        <TextView
            android:id="@+id/txt_topping"
            style="@style/text_16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/topping"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/View1"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/txt_depTopping"
            style="@style/text_text_14sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Chọn tối đa 3 loại topping"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/txt_topping"
            tools:ignore="MissingConstraints" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_topping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="@+id/radioGroupSizes"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/txt_depTopping"
            tools:ignore="MissingConstraints" />
        <!-- END VIEW TOPPING  -->

        <View
            android:id="@+id/View2"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="2dp"
            android:background="@color/search"
            app:layout_constraintEnd_toEndOf="@+id/linearLayout2"
            app:layout_constraintStart_toStartOf="@+id/linearLayout2"
            app:layout_constraintTop_toBottomOf="@+id/rcv_topping"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/txt_Different"
            style="@style/text_16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Yêu cầu khác"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/View2"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/txt_depDifferent"
            style="@style/text_text_14sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Những tùy chọn khác"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/txt_Different"
            tools:ignore="MissingConstraints" />

        <EditText
            android:id="@+id/editTextDifferent"
            style="@style/TextPlaceholder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:ems="10"
            android:inputType="text"
            android:hint="Thêm ghi chú"
            android:padding="20dp"
            android:background="@drawable/rounder_component_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txt_depDifferent"
            app:layout_constraintTop_toBottomOf="@+id/txt_depDifferent" />

        <!--        VIEW ADD TO CART NAVIGATION    -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/editTextDifferent"
            tools:ignore="MissingConstraints">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomProductDetailView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rounder_background_addcart">

                <TextView
                    android:id="@+id/txt_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30.000"
                    android:textSize="28sp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp">

                    <include layout="@layout/component_button_count"></include>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="100dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginRight="24dp">

                    <Button
                        android:id="@+id/btn_addtocart"
                        style="@style/ButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="THÊM VÀO GIỎ HÀNG"/>
                </LinearLayout>
            </com.google.android.material.bottomnavigation.BottomNavigationView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>