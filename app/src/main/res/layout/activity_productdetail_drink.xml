<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/img_drink"
            android:layout_width="0dp"
            android:layout_height="321dp"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/img1"
            tools:ignore="MissingConstraints" />

        <FrameLayout
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/circle_background"
            android:padding="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints">

            <ImageView
                android:id="@+id/img_lessthan"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/less_than" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_heart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/circle_background"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints">

            <ImageView
                android:id="@+id/img_heart"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart" />
        </FrameLayout>

        <TextView
            android:id="@+id/txt_NameDrink"
            style="@style/Heading2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Trà sữa chân châu đường đen"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_drink"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/txt_priceDrink"
            style="@style/text_14sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="30.000đ"
            app:layout_constraintEnd_toEndOf="@+id/txt_NameDrink"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/txt_NameDrink"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/ic_star_green"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="7dp"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="@+id/txt_priceDrink"
            app:layout_constraintTop_toBottomOf="@+id/txt_priceDrink"
            app:srcCompat="@drawable/ic_star_green"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/text_ic_star"
            style="@style/Heading3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="4.7"
            app:layout_constraintStart_toEndOf="@+id/ic_star_green"
            app:layout_constraintTop_toTopOf="@+id/ic_star_green"
            tools:ignore="HardcodedText,MissingConstraints" />

        <ImageView
            android:id="@+id/ic_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            app:layout_constraintStart_toEndOf="@+id/text_ic_star"
            app:layout_constraintTop_toTopOf="@+id/ic_star_green"
            app:srcCompat="@drawable/ic_comment" />

        <TextView
            android:id="@+id/txt_comment"
            style="@style/Heading3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="5"
            app:layout_constraintStart_toEndOf="@+id/ic_comment"
            app:layout_constraintTop_toTopOf="@+id/ic_comment"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/txt_descriptionProduct"
            style="@style/text_text_14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:text="@string/description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/ic_star_green"
            app:layout_constraintTop_toBottomOf="@+id/ic_star_green"
            tools:ignore="MissingConstraints" />

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_descriptionProduct"
            tools:ignore="MissingConstraints">

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@color/search"
                tools:layout_editor_absoluteX="4dp"
                tools:layout_editor_absoluteY="235dp" />
        </LinearLayout>

        <!--        START VIEW SIZE            -->
        <TextView
            android:id="@+id/txt_size"
            style="@style/text_16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/size"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/txt_depSize"
            style="@style/text_text_14sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Chọn 1 loại size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/txt_size"
            tools:ignore="MissingConstraints" />

        <!--  RadioButton Lớn  -->
        <LinearLayout
            android:id="@+id/linearLayoutRdBtnLarge"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_depSize"
            tools:ignore="MissingConstraints">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lớn" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40,000₫" />

        </LinearLayout>

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@color/box"
            app:layout_constraintBottom_toBottomOf="@+id/linearLayoutRdBtnLarge"
            app:layout_constraintEnd_toEndOf="@+id/linearLayoutRdBtnLarge"
            app:layout_constraintStart_toStartOf="@+id/linearLayoutRdBtnLarge"
            tools:ignore="MissingConstraints" />

        <!-- RadioButton Vừa -->
        <LinearLayout
            android:id="@+id/linearLayoutRdBtnMedium"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/linearLayoutRdBtnLarge"
            app:layout_constraintTop_toBottomOf="@+id/linearLayoutRdBtnLarge"
            tools:ignore="MissingConstraints">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vừa" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35,000₫" />

        </LinearLayout>

        <View
            android:id="@+id/view3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@color/box"
            app:layout_constraintEnd_toEndOf="@+id/linearLayoutRdBtnLarge"
            app:layout_constraintStart_toStartOf="@+id/linearLayoutRdBtnLarge"
            app:layout_constraintTop_toBottomOf="@+id/linearLayoutRdBtnMedium"
            tools:ignore="MissingConstraints" />


        <!-- RadioButton Nhỏ -->
        <LinearLayout
            android:id="@+id/linearLayoutRdBtnSmall"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintEnd_toEndOf="@+id/linearLayoutRdBtnLarge"
            app:layout_constraintStart_toStartOf="@+id/linearLayoutRdBtnLarge"
            app:layout_constraintTop_toBottomOf="@+id/linearLayoutRdBtnMedium"
            tools:ignore="MissingConstraints">

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nhỏ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30,000₫" />
        </LinearLayout>
        <!--  END VIEW SIZE  -->

        <View
            android:id="@+id/View1"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="2dp"
            android:background="@color/search"
            app:layout_constraintEnd_toEndOf="@+id/linearLayout2"
            app:layout_constraintStart_toStartOf="@+id/linearLayout2"
            app:layout_constraintTop_toBottomOf="@+id/linearLayoutRdBtnSmall"
            tools:ignore="MissingConstraints" />

        <!-- START VIEW TOPPING  -->
        <TextView
            android:id="@+id/txt_topping"
            style="@style/text_16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/topping"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/View1"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/txt_depTopping"
            style="@style/text_text_14sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Chọn tối đa 3 loại topping"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/txt_topping"
            tools:ignore="MissingConstraints" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_topping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="@+id/linearLayoutRdBtnLarge"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/txt_depTopping"
            tools:ignore="MissingConstraints" />
        <!-- END VIEW TOPPING  -->

        <View
            android:id="@+id/View2"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="2dp"
            android:background="@color/search"
            app:layout_constraintEnd_toEndOf="@+id/linearLayout2"
            app:layout_constraintStart_toStartOf="@+id/linearLayout2"
            app:layout_constraintTop_toBottomOf="@+id/rcv_topping"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/txt_Different"
            style="@style/text_16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Yêu cầu khác"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/View2"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/txt_depDifferent"
            style="@style/text_text_14sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Những tùy chọn khác"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txt_NameDrink"
            app:layout_constraintTop_toBottomOf="@+id/txt_Different"
            tools:ignore="MissingConstraints" />

        <EditText
            android:id="@+id/editTextDifferent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:ems="10"
            android:inputType="text"
            android:hint="Thêm ghi chú"
            android:textSize="10sp"
            android:background="@drawable/rounder_color_productdetail"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/txt_depDifferent"
            app:layout_constraintTop_toBottomOf="@+id/txt_depDifferent" />

        <!--        VIEW ADD TO CART NAVIGATION    -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/editTextDifferent"
            tools:ignore="MissingConstraints">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomProductDetailView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rounder_background_addcart">

                <TextView
                    android:id="@+id/txt_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30.000"
                    android:textSize="28sp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp">

                    <include layout="@layout/component_button_count"></include>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="100dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginRight="24dp">

                    <Button
                        android:id="@+id/btn_addtocart"
                        style="@style/ButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="ADD TO CART"/>
                </LinearLayout>
            </com.google.android.material.bottomnavigation.BottomNavigationView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <!--        START DIALOG COMMENT  -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/commentDialogFragment"
            android:name="com.example.foodorderingapp.adapter.CommentDialogFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>