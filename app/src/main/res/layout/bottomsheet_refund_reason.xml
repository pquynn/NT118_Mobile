<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable name="reason" type="String"/>
<!--        <variable name="orderItem" type="com.example.foodorderingapp.data.model.entity.OrderItem"/>-->
<!--        <variable name="product" type="com.example.foodorderingapp.data.model.entity.Product"/>-->
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/top_rounded_background">


        <TextView
            android:id="@+id/reason_heading"
            style="@style/bold_text_20sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Chọn lý do hoàn tiên"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_add"
            style="@style/ButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp"
            android:text="Xác nhận"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/radio_group" />

        <RadioGroup
            android:id="@+id/radio_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/reason_heading">

            <RadioButton
                android:id="@+id/radio_btn1"
                style="@style/regular_text_16sp"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:buttonTint="@color/primary"
                android:text="Gửi sai sản phẩm"
                android:checked="@{reason != null &amp;&amp; reason.equals(@string/reason1)}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioButton
                android:id="@+id/radio_btn2"
                style="@style/regular_text_16sp"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Khác với mô tả"
                android:checked="@{reason != null &amp;&amp; reason.equals(@string/reason2)}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioButton
                android:id="@+id/radio_btn3"
                style="@style/regular_text_16sp"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Hàng bể vỡ"
                android:checked="@{reason != null &amp;&amp; reason.equals(@string/reason3)}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </RadioGroup>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>