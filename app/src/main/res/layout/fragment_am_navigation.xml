    <Button
        android:id="@+id/btn_log_out"
        style="@style/ButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="16dp"
        android:text="Đăng xuất"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/framelayout2" />


    <ImageView
        android:id="@+id/am_btn_goto1"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/frameLayout"
        app:layout_constraintTop_toTopOf="@+id/frameLayout"
        app:srcCompat="@drawable/am_btn_go" />

    <ImageView
        android:id="@+id/am_btn_goto2"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/frameLayout"
        app:layout_constraintTop_toBottomOf="@+id/am_btn_goto1"
        app:srcCompat="@drawable/am_btn_go" />

    <ImageView
        android:id="@+id/am_btn_goto3"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="33dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/frameLayout"
        app:layout_constraintTop_toBottomOf="@+id/am_btn_goto2"
        app:srcCompat="@drawable/am_btn_go" />

    <ImageView
        android:id="@+id/am_btn_goto4"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/framelayout2"
        app:layout_constraintTop_toTopOf="@+id/framelayout2"
        app:srcCompat="@drawable/am_btn_go" />

    <ImageView
        android:id="@+id/am_btn_goto5"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="43dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="@+id/framelayout2"
        app:layout_constraintTop_toBottomOf="@+id/am_btn_goto4"
        app:srcCompat="@drawable/am_btn_go" />

</androidx.constraintlayout.widget.ConstraintLayout>