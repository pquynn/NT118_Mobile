<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:paddingBottom="24dp"
        tools:context=".ui.activityfragment.customer.accountmanagement.am_order_detail">


        <LinearLayout
            android:id="@+id/llAM_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_marginTop="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="MissingConstraints">

            <ImageView
                android:id="@+id/avatar_acc"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/am_btn_per_info"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/textView_name_acc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/avatar_acc"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints" />
        </LinearLayout>

        <LinearLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/allrounded_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llAM_user"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/llAM_userInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/am_btn_per_info"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/am_btn_per_info" />

            <TextView
                android:id="@+id/am_lbl_Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="Thông tin cá nhân"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"/>

            <ImageView
                android:id="@+id/am_btn_goto1"
                android:layout_width="15dp"
                android:layout_height="15dp"
                app:srcCompat="@drawable/am_btn_go" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llAM_userpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/am_btn_score"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/am_btn_score" />

            <TextView
                android:id="@+id/am_lbl_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="Tích điểm"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"/>

            <ImageView
                android:id="@+id/am_btn_goto2"
                android:layout_width="15dp"
                android:layout_height="15dp"
                app:srcCompat="@drawable/am_btn_go" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llAM_userAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/am_btn_address"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/am_btn_address" />

            <TextView
                android:id="@+id/am_lbl_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="Địa chỉ của tôi"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"/>

            <ImageView
                android:id="@+id/am_btn_goto3"
                android:layout_width="15dp"
                android:layout_height="15dp"
                app:srcCompat="@drawable/am_btn_go" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/framelayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/allrounded_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/llAM_userOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/am_btn_orders"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/am_btn_orders" />

            <TextView
                android:id="@+id/am_lbl_orders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="Đơn hàng của tôi"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"/>

            <ImageView
                android:id="@+id/am_btn_goto4"
                android:layout_width="15dp"
                android:layout_height="15dp"
                app:srcCompat="@drawable/am_btn_go" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llAM_faqs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/am_btn_faqs"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/am_btn_faqs" />

            <TextView
                android:id="@+id/am_lbl_faqs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="FAQs"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"/>

            <ImageView
                android:id="@+id/am_btn_goto5"
                android:layout_width="15dp"
                android:layout_height="15dp"
                app:srcCompat="@drawable/am_btn_go" />

        </LinearLayout>
    </LinearLayout>


    <Button
        android:id="@+id/btn_log_out"
        style="@style/ButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="16dp"
        android:text="Đăng xuất"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/framelayout2" />


</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>