<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewholder_coupon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_grey_container"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="10dp">


    <FrameLayout
        android:id="@+id/green_rec"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/rectangle_primary"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_coupon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/coupon_white" />

    </FrameLayout>


    <TextView
        android:id="@+id/txt_description"
        style="@style/text_14sp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:singleLine="false"
        android:text="Giảm 10.000đ cho đơn hàng từ 100.000đ"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/green_rec"
        app:layout_constraintTop_toBottomOf="@+id/txt_coupon_name" />

    <TextView
        android:id="@+id/txt_coupon_name"

        style="@style/bold_text_18sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:text="Giảm 10.000đ"
        app:layout_constraintStart_toEndOf="@+id/green_rec"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_valid_date"
        style="@style/light_text_14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="13:31 06-03-2025"
        android:textSize="12sp"
        android:textColor="#9C9BA6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/green_rec"
        app:layout_constraintTop_toBottomOf="@+id/txt_description" />

</androidx.constraintlayout.widget.ConstraintLayout>